NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

POSTGRES_DB=execution_assistant
POSTGRES_USER=execution_assistant
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://execution_assistant:local-development-only@localhost:5432/execution_assistant
TEST_DATABASE_URL=postgresql://execution_assistant:local-development-only@localhost:5432/execution_assistant_test

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
AUTH_ALLOWED_CALLBACK_URLS=http://localhost:3000/auth/google/callback
WEB_APP_URL=http://localhost:5173
E2E_AUTH_ENABLED=false
SESSION_COOKIE_NAME=execution_session
SESSION_TTL_DAYS=30
CARRYOVER_WARNING_COUNT=2
CARRYOVER_DIAGNOSIS_COUNT=3
CARRYOVER_EXPLICIT_CHOICE_COUNT=5
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_SUBSCRIBERS_PER_USER=5
SSE_MAX_SUBSCRIBERS_TOTAL=1000
ASSISTANT_PROVIDER=disabled
OPENAI_MODEL=gpt-5.6-sol
ASSISTANT_REASONING_EFFORT=low
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
ASSISTANT_MAX_CONCURRENCY_PER_USER=2
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_WORKER_INTERVAL_MS=1000
ASSISTANT_LEASE_SECONDS=30
# OPENAI_API_KEY=store-outside-source-control
